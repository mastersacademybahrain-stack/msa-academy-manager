                  </div>
                  <div class="flex justify-between item-center">
                    <span class="text-gray-600">2 Months (2x/week)</span>
                    <span class="font-semibold text-gray-800">BD 170</span>
                  </div>
                </div>
              </div>-->
            <div class="text-center">
              <a class="bg-red-500 hover:bg-red-600 text-white px-6 py-2 rounded-button font-medium transition-all whitespace-nowrap"
                target="_blank"
                href="https://wa.me/97336885993?text=Hi%20Master%20Sports%20Academy!%0A%0AI'm%20interested%20in%20joining%20your%20tennis%20Red%20Group%20program.">Contact
                for Enrollment</a>
            </div>
          </div>
        </div>
        <!-- Orange Group -->
        <div id="orange-group" class="program-card orange-accent bg-white rounded-lg shadow-md fade-up overflow-hidden">
          <div class="p-6">
            <span class="bg-orange-500 text-white text-sm px-3 py-1 rounded-full">Tennis</span>
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-xl font-bold text-gray-800">Orange Group</h3>
              <span class="bg-orange-500 text-white text-sm px-3 py-1 rounded-full">Ages 7-8</span>
            </div>
            <p class="text-gray-600 mb-4">
              <strong>Focus:</strong> Advanced Skills Development
            </p>
            <div class="mb-4">
              <h4 class="font-semibold text-gray-700 mb-2">Key Skills:</h4>
              <ul class="text-gray-600 space-y-1">
                <li class="flex items-start">
                  <div class="w-5 h-5 flex items-center justify-center mr-2 mt-0.5">
                    <i class="ri-check-line text-orange-500"></i>
                  </div>
                  Volley techniques
                </li>
