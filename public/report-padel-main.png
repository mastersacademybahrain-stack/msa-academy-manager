<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Masters Sport Academy - Premier Tennis Coaching in Bahrain</title>

  <!-- SEO Meta Tags -->
  <meta name="description"
    content="Transform your tennis game with Masters Sport Academy in Bahrain. Expert coaching for all ages and skill levels. Join our professional tennis training programs today." />
  <meta name="keywords"
    content="tennis academy bahrain, tennis coaching, tennis lessons, tennis training, tennis programs, kids tennis, adult tennis, reef island tennis" />
  <meta name="author" content="Masters Sport Academy" />

  <!-- Open Graph Meta Tags -->
  <meta property="og:title" content="Masters Sport Academy - Tennis Coaching in Bahrain" />
  <meta property="og:description"
    content="Expert tennis coaching programs for all ages and skill levels in Bahrain. Transform your game with professional training." />
  <meta property="og:image" content="./assets/tennis_player.png" />
  <meta property="og:url" content="https://msabahrain.com" />
  <meta property="og:type" content="website" />

  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Masters Sport Academy - Tennis Coaching in Bahrain" />
  <meta name="twitter:description"
    content="Expert tennis coaching programs for all ages and skill levels in Bahrain. Transform your game with professional training." />
  <meta name="twitter:image" content="./assets/tennis_player.png" />

  <!-- Canonical URL -->
  <link rel="canonical" href="https://msabahrain.com" />
  <script src="https://cdn.tailwindcss.com/3.4.16"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: { primary: "#4b2e83", secondary: "#f7b733" },
          borderRadius: {
            none: "0px",
            sm: "4px",
            DEFAULT: "8px",
            md: "12px",
            lg: "16px",
            xl: "20px",
            "2xl": "24px",
            "3xl": "32px",
            full: "9999px",
            button: "8px",
          },
        },
      },
    };
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css" />
  <!-- Swiper CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <style>
    :where([class^="ri-"])::before {
      content: "\f3c2";
    }

    body {
      font-family: "Inter", sans-serif;
    }

    .program-card {
      transition: all 0.3s ease;
      background: linear-gradient(to bottom right, #ffffff, #f8fafc);
      border: 1px solid rgba(226, 232, 240, 0.8);
    }

    .program-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
      /* background: linear-gradient(to bottom right, #ffffff, #f0f9ff); */
    }

    .red-accent {
      background: linear-gradient(45deg,
          rgba(239, 68, 68, 0.1),
          rgba(239, 68, 68, 0.05));
      border-left: 4px solid #ef4444;
    }

    .orange-accent {
      background: linear-gradient(45deg,
          rgba(249, 115, 22, 0.1),
          rgba(249, 115, 22, 0.05));
      border-left: 4px solid #f97316;
    }

    .green-accent {
      background: linear-gradient(45deg,
          rgba(34, 197, 94, 0.1),
          rgba(34, 197, 94, 0.05));
      border-left: 4px solid #22c55e;
    }

    .yellow-accent {
      background: linear-gradient(45deg,
          rgba(234, 179, 8, 0.1),
          rgba(234, 179, 8, 0.05));
      border-left: 4px solid #eab308;
    }

    .blue-accent {
      background: linear-gradient(45deg,
          rgba(37, 99, 235, 0.1),
          rgba(37, 99, 235, 0.05));
      border-left: 4px solid #2563eb;
    }

    .gray-accent {
      background: linear-gradient(45deg,
          rgba(71, 85, 105, 0.1),
          rgba(71, 85, 105, 0.05));
      border-left: 4px solid #475569;
    }

    /* Swiper Customizations */
    .swiper-pagination-bullet {
      background-color: rgba(0, 0, 0, 0.1) !important;
      opacity: 1 !important;
      transition: all 0.3s ease;
    }

    .swiper-pagination-bullet-active {
      background-color: #f7b733 !important;
      /* Secondary color */
      box-shadow: 0 0 10px rgba(247, 183, 51, 0.5);
      width: 32px !important;
      border-radius: 4px !important;
    }

    /* Slide Animations */
    .slide-content>* {
      opacity: 0;
      transform: translateY(30px);
      transition: all 0.8s ease;
    }

    .slide-bg-image,
    .slide-bg-video {
      transform: scale(1.05);
      transition: transform 6s ease;
    }

    .swiper-slide-active .slide-content>span {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.2s;
    }

    .swiper-slide-active .slide-content>h1 {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.4s;
    }

    .swiper-slide-active .slide-content>p {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.6s;
    }

    .swiper-slide-active .slide-content>div {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.8s;
    }

    .swiper-slide-active .slide-bg-image,
    .swiper-slide-active .slide-bg-video {
      transform: scale(1);
    }

    .testimonial-card {
      transition: all 0.3s ease;
      background: linear-gradient(to bottom right, #ffffff, #f8fafc);
      border: 1px solid rgba(226, 232, 240, 0.8);
    }

    .testimonial-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.06);
    }

    .contact-form input:focus,
    .contact-form textarea:focus,
    .contact-form select:focus {
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .fade-up {
      opacity: 0;
      transform: translateY(30px);
      transition: all 0.6s ease-out;
      will-change: opacity, transform;
    }

    .fade-up.visible {
      opacity: 1;
      transform: translateY(0);
    }

    @media (max-width: 767px) {
      .swiper-button-prev {
        display: none !important;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .fade-up {
        transition: none;
        opacity: 1;
        transform: none;
      }
    }
  </style>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="shortcut icon" href="./assets/favicon.ico" type="image/x-icon" />
</head>

<body class="bg-gray-50" itemscope itemtype="http://schema.org/SportsClub">
  <!-- Header -->
  <header class="bg-white/80 backdrop-blur-md fixed w-full top-0 z-50 border-b border-gray-100">
    <div class="container mx-auto px-6 py-4 flex justify-between items-center">
      <div class="flex items-center">
        <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center">
          <span class="text-primary text-xl font-bold"><img src="./assets/logo.png" alt="logo" /></span>
        </div>
        <span class="ml-3 text-primary font-semibold">Masters Sport Academy</span>
      </div>
      <!-- Desktop Navigation -->
      <nav class="hidden md:flex space-x-8">
        <a href="#home" class="text-gray-800 hover:text-primary font-medium">Home</a>
        <a href="#programs" class="text-gray-800 hover:text-primary font-medium">Programs</a>
        <a href="#gallery" class="text-gray-800 hover:text-primary font-medium">Gallery</a>
        <a href="#about-us" class="text-gray-800 hover:text-primary font-medium">About Us</a>
        <a href="#contact" class="text-gray-800 hover:text-primary font-medium">Contact</a>
      </nav>
      <!-- Mobile Navigation Toggle -->
      <div class="md:hidden">
        <button id="menu-toggle" class="text-gray-800 focus:outline-none">
          <div class="w-10 h-10 flex items-center justify-center">
            <i class="ri-menu-line ri-lg"></i>
          </div>
        </button>
      </div>
    </div>
    <!-- Mobile Navigation Menu -->
    <div id="mobile-menu" class="hidden md:hidden bg-white">
      <div class="container mx-auto px-4 py-3 space-y-3">
        <a href="#home" class="block text-gray-800 hover:text-primary font-medium py-2">Home</a>
        <a href="#programs" class="block text-gray-800 hover:text-primary font-medium py-2">Programs</a>
        <a href="#gallery" class="block text-gray-800 hover:text-primary font-medium py-2">Gallery</a>
        <a href="#about-us" class="block text-gray-800 hover:text-primary font-medium py-2">About Us</a>
        <a href="#contact" class="block text-gray-800 hover:text-primary font-medium py-2">Contact</a>
      </div>
    </div>
  </header>
  <!-- Hero Section -->
  <section id="home" class="relative h-screen min-h-[600px] w-full overflow-hidden bg-white">
    <!-- Swiper -->
    <div class="swiper hero-swiper h-full w-full">
      <div class="swiper-wrapper">

        <!-- Slide 1: Tennis -->
        <div class="swiper-slide relative overflow-hidden" data-swiper-autoplay="28000">
          <div class="absolute inset-0 z-0">
            <video autoplay loop muted playsinline
              class="w-full h-full object-cover object-[center_20%] slide-bg-video opacity-90">
              <source src="./assets/hero-tennis.webm" type="video/webm" />
              <source src="./assets/hero-tennis.mp4" type="video/mp4" />
            </video>
            <div class="absolute inset-0 bg-gradient-to-r from-white/80 via-white/50 to-transparent">
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-white/60 via-transparent to-transparent"></div>
          </div>
          <div class="container mx-auto px-6 h-full flex items-center relative z-10 pt-20">
            <div class="md:w-2/3 max-w-3xl slide-content">
              <span
                class="inline-block py-1 px-3 rounded-full bg-primary/10 text-primary border border-primary/20 backdrop-blur-md text-sm font-semibold tracking-wider mb-4 uppercase">MSA
                Academy</span>
              <h1 class="text-5xl md:text-7xl font-bold text-gray-900 mb-6 leading-tight drop-shadow-sm">
                Master the Court with <span class="text-secondary">Tennis</span>
              </h1>
              <p class="text-xl md:text-2xl text-gray-700 mb-8 leading-relaxed max-w-2xl font-medium">
                Professional coaching from top-tier experts. Elevate your technique, strategy, and mental game.
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                <a href="#programs"
                  class="bg-primary hover:bg-primary/90 text-white px-8 py-4 rounded-button font-medium text-lg inline-block transition-transform duration-300 whitespace-nowrap text-center shadow-lg hover:-translate-y-1">Explore
                  Tennis</a>
                <a href="#contact"
                  class="bg-white hover:bg-gray-50 text-gray-900 border border-gray-200 shadow-sm px-8 py-4 rounded-button font-medium text-lg inline-block transition-transform duration-300 whitespace-nowrap text-center hover:-translate-y-1">Contact
                  Us</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Slide 2: Swimming -->
        <div class="swiper-slide relative overflow-hidden">
          <div class="absolute inset-0 z-0">
            <img src="./assets/hero-swimming.png" alt="Swimming at MSA"
              class="w-full h-full object-cover object-[center_30%] slide-bg-image opacity-90" />
            <div class="absolute inset-0 bg-gradient-to-r from-white/80 via-white/50 to-transparent">
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-white/60 via-transparent to-transparent"></div>
          </div>
          <div class="container mx-auto px-6 h-full flex items-center relative z-10 pt-20">
            <div class="md:w-2/3 max-w-3xl slide-content">
              <span
                class="inline-block py-1 px-3 rounded-full bg-blue-50 text-blue-600 border border-blue-200 backdrop-blur-md text-sm font-semibold tracking-wider mb-4 uppercase">MSA
                Academy</span>
              <h1 class="text-5xl md:text-7xl font-bold text-gray-900 mb-6 leading-tight drop-shadow-sm">
                Dive into <span class="text-blue-600">Excellence</span>
              </h1>
              <p class="text-xl md:text-2xl text-gray-700 mb-8 leading-relaxed max-w-2xl font-medium">
                Olympic-standard swimming programs for all ages. Build endurance, perfect your stroke, and conquer the
                water.
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                <a href="#programs"
                  class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-4 rounded-button font-medium text-lg inline-block transition-transform duration-300 whitespace-nowrap text-center shadow-lg hover:-translate-y-1">View
                  Programs</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Slide 3: Fitness -->
        <div class="swiper-slide relative overflow-hidden">
          <div class="absolute inset-0 z-0">
            <img src="./assets/hero-fitness.png" alt="Fitness at MSA"
              class="w-full h-full object-cover object-[center_30%] slide-bg-image opacity-90" />
            <div class="absolute inset-0 bg-gradient-to-r from-white/80 via-white/50 to-transparent">
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-white/60 via-transparent to-transparent"></div>
          </div>
          <div class="container mx-auto px-6 h-full flex items-center relative z-10 pt-20">
            <div class="md:w-2/3 max-w-3xl slide-content">
              <span
                class="inline-block py-1 px-3 rounded-full bg-green-50 text-green-600 border border-green-200 backdrop-blur-md text-sm font-semibold tracking-wider mb-4 uppercase">MSA
                Academy</span>
              <h1 class="text-5xl md:text-7xl font-bold text-gray-900 mb-6 leading-tight drop-shadow-sm">
                Transform Your <span class="text-green-600">Fitness</span>
              </h1>
              <p class="text-xl md:text-2xl text-gray-700 mb-8 leading-relaxed max-w-2xl font-medium">
                State-of-the-art facilities and personalized training plans to help you achieve your ultimate physical
                potential.
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                <a href="#programs"
                  class="bg-green-600 hover:bg-green-700 text-white px-8 py-4 rounded-button font-medium text-lg inline-block transition-transform duration-300 whitespace-nowrap text-center shadow-lg hover:-translate-y-1">Start
                  Training</a>
              </div>
            </div>
          </div>
        </div>

      </div>
      <!-- Pagination & Navigation -->
      <div class="swiper-pagination mb-4"></div>
      <div class="swiper-button-prev !text-gray-500 hover:!text-primary transition-colors duration-300 ml-2 md:ml-4">
      </div>
      <div class="swiper-button-next !text-gray-500 hover:!text-primary transition-colors duration-300 mr-2 md:mr-4">
      </div>
    </div>

    <!-- Stats Overlay (Bottom) -->
    <div
      class="absolute bottom-0 left-0 w-full z-20 bg-gradient-to-t from-white via-white/90 to-transparent pt-12 pb-6 md:pb-10 pointer-events-none">
      <div class="container mx-auto px-6">
        <div class="grid grid-cols-3 gap-4 md:gap-8 max-w-3xl border-t border-gray-200 pt-6">
          <div>
            <h3 class="text-2xl md:text-4xl font-bold text-gray-900">15+</h3>
            <p class="text-gray-600 text-xs md:text-base font-semibold mt-1 uppercase tracking-wider">Expert Coaches</p>
          </div>
          <div>
            <h3 class="text-2xl md:text-4xl font-bold text-gray-900">200+</h3>
            <p class="text-gray-600 text-xs md:text-base font-semibold mt-1 uppercase tracking-wider">Students Trained
            </p>
          </div>
          <div>
            <h3 class="text-2xl md:text-4xl font-bold text-gray-900">20+</h3>
            <p class="text-gray-600 text-xs md:text-base font-semibold mt-1 uppercase tracking-wider">Years Exp.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Programs Section -->
  <section id="programs" class="py-12 md:py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-4">
          Our Training Programs
        </h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Personalized programs focused on skill development, confidence building, and fostering a passion for fitness
          and active lifestyles.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Red Group -->
        <div class="program-card red-accent bg-white rounded-lg shadow-md fade-up overflow-hidden" id="red-group">
          <div class="p-6">
            <span class="bg-red-500 text-white text-sm px-3 py-1 rounded-full">Tennis</span>
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-xl font-bold text-gray-800">Red Group</h3>
              <span class="bg-red-500 text-white text-sm px-3 py-1 rounded-full">Ages 4-6</span>
            </div>
            <p class="text-gray-600 mb-4">
              <strong>Focus:</strong> Fundamentals & Fun
            </p>
            <div class="mb-4">
              <h4 class="font-semibold text-gray-700 mb-2">Key Skills:</h4>
              <ul class="text-gray-600 space-y-1">
                <li class="flex items-start">
                  <div class="w-5 h-5 flex items-center justify-center mr-2 mt-0.5">
                    <i class="ri-check-line text-red-500"></i>
                  </div>
                  Proper grip techniques
                </li>
                <li class="flex items-start">
                  <div class="w-5 h-5 flex items-center justify-center mr-2 mt-0.5">
                    <i class="ri-check-line text-red-500"></i>
                  </div>
                  Basic strokes introduction
                </li>
                <li class="flex items-start">
                  <div class="w-5 h-5 flex items-center justify-center mr-2 mt-0.5">
                    <i class="ri-check-line text-red-500"></i>
                  </div>
                  Fundamental footwork
                </li>
              </ul>
            </div>
            <div class="mb-4">
              <h4 class="font-semibold text-gray-700 mb-2">
                Learning Through:
              </h4>
              <ul class="text-gray-600 space-y-1">
                <li class="flex items-start">
                  <div class="w-5 h-5 flex items-center justify-center mr-2 mt-0.5">
                    <i class="ri-tennis-ball-line text-red-500"></i>
                  </div>
                  Mini tennis activities
                </li>
                <li class="flex items-start">
                  <div class="w-5 h-5 flex items-center justify-center mr-2 mt-0.5">
                    <i class="ri-gamepad-line text-red-500"></i>
                  </div>
                  Interactive games
                </li>
              </ul>
            </div>
            <div class="mb-6">
              <h4 class="font-semibold text-gray-700 mb-2">
                Physical & Mental Development:
              </h4>
              <ul class="text-gray-600 space-y-1">
                <li class="flex items-start">
                  <div class="w-5 h-5 flex items-center justify-center mr-2 mt-0.5">
                    <i class="ri-heart-pulse-line text-red-500"></i>
                  </div>
                  Basic fitness & coordination
                </li>
                <li class="flex items-start">
                  <div class="w-5 h-5 flex items-center justify-center mr-2 mt-0.5">
                    <i class="ri-mental-health-line text-red-500"></i>
                  </div>
                  Focus & concentration skills
                </li>
              </ul>
            </div>
            <div class="bg-red-50 p-4 rounded-lg mb-6">
              <h4 class="font-semibold text-gray-700 mb-2">
                Available Locations
              </h4>
              <div class="grid grid-cols-2 gap-2">
                <div class="flex items-center space-x-2">
                  <i class="ri-map-pin-line text-red-500"></i>
                  <span class="text-gray-600"><a target="_blank"
                      href="https://maps.app.goo.gl/wxhRCcobDE8fePqr6?g_st=com.google.maps.preview.copy">Reef
                      Island</a></span>
                </div>
                <!-- <div class="flex items-center space-x-2">
                    <i class="ri-map-pin-line text-red-500"></i>
                    <span class="text-gray-600">British Club</span>
                  </div>
                  <div class="flex items-center space-x-2">
                    <i class="ri-map-pin-line text-red-500"></i>
                    <span class="text-gray-600">BTF</span>
                  </div>
                  <div class="flex items-center space-x-2">
                    <i class="ri-map-pin-line text-red-500"></i>
                    <span class="text-gray-600">Own Court</span>
                  </div> -->
              </div>
            </div>
            <!--<div class="bg-red-50 p-4 rounded-lg mb-6">
                <h4 class="font-semibold text-gray-700 mb-2">Program Fees</h4>
                <div class="space-y-2">
                  <div class="flex justify-between items-center">
